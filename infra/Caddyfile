# ==============================================================================
# POLARIS CADDY PROXY CONFIGURATION
# Features:
# - Automatic TLS certificates via Let's Encrypt / ZeroSSL
# - Immediate unbuffered flushing on SSE streaming routes
# - Strict CORS headers locked to the frontend domain
# ==============================================================================

{$API_DOMAIN:api.polaris-observatory.com} {
    # Unbuffered SSE telemetry route
    handle /api/race/*/stream {
        reverse_proxy localhost:3000 {
            flush_interval -1
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # General API routes
    handle /api/* {
        reverse_proxy localhost:3000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Health check probe
    handle /health {
        reverse_proxy localhost:3000/api/health
    }

    # Global security and CORS headers
    header {
        Access-Control-Allow-Origin "{$ALLOWED_ORIGIN:https://polaris-observatory.vercel.app}"
        Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization, x-request-id"
        Access-Control-Expose-Headers "x-request-id, Retry-After"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
