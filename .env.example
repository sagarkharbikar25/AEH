# POLARIS environment
# Copy to .env and fill in. Never commit a filled-in .env.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated list of allowed browser origins (CORS).
# In production this is the Vercel domain only.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Amazon Bedrock (the API calls Bedrock through the instance IAM role)
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Optional when running on EC2 with an instance profile. Never commit keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Set to true to force the local simulator instead of calling Bedrock.
BEDROCK_MOCK=false
# Max attempts and base delay for the Bedrock retry with backoff.
BEDROCK_MAX_RETRIES=3
BEDROCK_RETRY_BASE_MS=250

# ---------------------------------------------------------------------------
# Strands Decider 2B
# ---------------------------------------------------------------------------
DECIDER_URL=http://localhost:8000
# Abort deadline for a single Decider call, milliseconds.
DECIDER_TIMEOUT_MS=2500
# Set to false to fail loudly when Decider is unreachable instead of falling
# back to the offline heuristic router. Never enable the fallback in a run
# whose numbers are published.
DECIDER_ALLOW_FALLBACK=true

# ---------------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------------
# Requests per minute per IP.
RATE_LIMIT_PER_MINUTE=60
# Daily spend ceiling in USD for the kill switch.
MAX_DAILY_BUDGET_USD=25
# Spend kill switch. When true the API refuses to start paid work.
SPEND_KILL_SWITCH=false

# ---------------------------------------------------------------------------
# Supabase (optional in development; the server falls back to a file store)
# ---------------------------------------------------------------------------
SUPABASE_URL=
# Service-role key. Server only. It must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=public

# ---------------------------------------------------------------------------
# Web (Vite, prefixed with VITE_)
# ---------------------------------------------------------------------------
# Absolute base URL of the Express API. The browser connects to it directly
# for SSE; do not proxy the stream through Vercel, it buffers.
VITE_API_BASE_URL=http://localhost:3000
