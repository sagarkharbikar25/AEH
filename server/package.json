{
  "name": "@polaris/server",
  "version": "1.0.0",
  "description": "POLARIS backend server - Dual-lane Bedrock Converse execution engine & real-time SSE stream",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/index.ts",
